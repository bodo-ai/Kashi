set(KASHI_IREE_REVISION 5332c68297a68fafd596277d7686f91009ebf1cb)
set(KASHI_ENABLE_CUDA OFF)
if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND NOT "$ENV{KASHI_DISABLE_CUDA}" STREQUAL "1")
  set(KASHI_ENABLE_CUDA ON)
endif()
set(KASHI_IREE_SDK_DIR "$ENV{KASHI_IREE_SDK_DIR}" CACHE PATH "Extracted IREE SDK directory")
set(_published_sdk_default OFF)
if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_PROCESSOR STREQUAL "x86_64")
  set(_published_sdk_default ON)
elseif(APPLE AND CMAKE_SYSTEM_PROCESSOR STREQUAL "arm64" AND
       CMAKE_SYSTEM_VERSION VERSION_GREATER_EQUAL 25 AND
       (NOT CMAKE_OSX_ARCHITECTURES OR CMAKE_OSX_ARCHITECTURES STREQUAL "arm64") AND
       (NOT CMAKE_OSX_DEPLOYMENT_TARGET OR CMAKE_OSX_DEPLOYMENT_TARGET VERSION_GREATER_EQUAL 26))
  # Darwin 25 is macOS 26, the minimum deployment target of the published SDK.
  set(_published_sdk_default ON)
endif()
option(KASHI_USE_PUBLISHED_IREE_SDK "Download the pinned IREE SDK instead of building from source" ${_published_sdk_default})
if(KASHI_USE_PUBLISHED_IREE_SDK AND NOT KASHI_IREE_SDK_DIR)
  include("${CMAKE_CURRENT_LIST_DIR}/KashiIreeSdk.cmake")
  kashi_fetch_iree_sdk(KASHI_IREE_SDK_DIR)
endif()
if(KASHI_IREE_SDK_DIR)
  if(APPLE AND CMAKE_OSX_ARCHITECTURES AND NOT CMAKE_OSX_ARCHITECTURES STREQUAL "arm64")
    message(FATAL_ERROR "The macOS IREE SDK requires an arm64-only build")
  endif()
  set(KashiIree_DIR "${KASHI_IREE_SDK_DIR}")
  find_package(KashiIree CONFIG REQUIRED PATHS "${KASHI_IREE_SDK_DIR}" NO_DEFAULT_PATH)
  if(NOT KASHI_SDK_IREE_REVISION STREQUAL KASHI_IREE_REVISION)
    message(FATAL_ERROR "IREE SDK revision ${KASHI_SDK_IREE_REVISION} does not match ${KASHI_IREE_REVISION}")
  endif()
  if(NOT KASHI_SDK_SYSTEM STREQUAL CMAKE_SYSTEM_NAME OR
     NOT KASHI_SDK_ARCH STREQUAL CMAKE_SYSTEM_PROCESSOR)
    message(FATAL_ERROR "IREE SDK targets ${KASHI_SDK_SYSTEM}/${KASHI_SDK_ARCH}; expected ${CMAKE_SYSTEM_NAME}/${CMAKE_SYSTEM_PROCESSOR}")
  endif()
  if(NOT KASHI_SDK_CUDA STREQUAL KASHI_ENABLE_CUDA)
    message(FATAL_ERROR "IREE SDK CUDA=${KASHI_SDK_CUDA}; this build requests CUDA=${KASHI_ENABLE_CUDA} (see KASHI_DISABLE_CUDA)")
  endif()
  set(IREE_TARGET_BACKEND_CUDA "${KASHI_SDK_CUDA}")
  if(CMAKE_OSX_DEPLOYMENT_TARGET AND CMAKE_OSX_DEPLOYMENT_TARGET VERSION_LESS KASHI_SDK_MACOS_DEPLOYMENT_TARGET)
    message(FATAL_ERROR "IREE SDK requires macOS ${KASHI_SDK_MACOS_DEPLOYMENT_TARGET} or later")
  endif()
  include("${PROJECT_SOURCE_DIR}/cpp/plugin/iree_compiler_plugin.cmake")
else()
  include("${CMAKE_CURRENT_LIST_DIR}/KashiIree.cmake")
endif()
