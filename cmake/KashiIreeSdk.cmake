function(kashi_fetch_iree_sdk out)
  file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/iree-sdk.json" manifest)
  string(JSON revision GET "${manifest}" revision)
  if(NOT revision STREQUAL KASHI_IREE_REVISION)
    message(FATAL_ERROR "Published IREE SDK revision ${revision} does not match ${KASHI_IREE_REVISION}")
  endif()
  string(TOLOWER "${CMAKE_SYSTEM_NAME}" system)
  set(backend cpu)
  if(KASHI_ENABLE_CUDA)
    set(backend cuda)
  endif()
  set(variant "${system}-${CMAKE_SYSTEM_PROCESSOR}-${backend}")
  string(JSON sha ERROR_VARIABLE missing GET "${manifest}" sha256 "${variant}")
  if(missing)
    message(FATAL_ERROR "No published IREE SDK for ${variant}; set KASHI_USE_PUBLISHED_IREE_SDK=OFF to build from source")
  endif()
  string(JSON base_url GET "${manifest}" base_url)
  if("$ENV{XDG_CACHE_HOME}" STREQUAL "")
    set(cache "$ENV{HOME}/.cache/kashi/iree-sdk")
  else()
    set(cache "$ENV{XDG_CACHE_HOME}/kashi/iree-sdk")
  endif()
  set(package "${cache}/${sha}/iree-sdk")
  if(NOT EXISTS "${package}/KashiIreeConfig.cmake")
    file(MAKE_DIRECTORY "${cache}")
    # Editable, lint and test configure invocations can share one extraction.
    file(LOCK "${cache}/${sha}.lock" GUARD FUNCTION TIMEOUT 300)
    if(NOT EXISTS "${package}/KashiIreeConfig.cmake")
      set(name "kashi-iree-sdk-${variant}.tar.zst")
      set(archive "${cache}/${sha}.tar.zst")
      set(stage "${cache}/${sha}.extract")
      message(STATUS "Fetching published IREE SDK (${variant})")
      file(DOWNLOAD "${base_url}/${revision}/${sha}/${name}" "${archive}"
        EXPECTED_HASH "SHA256=${sha}" TLS_VERIFY ON TIMEOUT 300)
      file(REMOVE_RECURSE "${stage}")
      file(MAKE_DIRECTORY "${stage}")
      file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${stage}")
      if(NOT EXISTS "${stage}/iree-sdk/KashiIreeConfig.cmake")
        message(FATAL_ERROR "Published IREE SDK ${variant} lacks KashiIreeConfig.cmake")
      endif()
      file(RENAME "${stage}" "${cache}/${sha}")
      file(REMOVE "${archive}")
    endif()
  endif()
  set(${out} "${package}" PARENT_SCOPE)
endfunction()
